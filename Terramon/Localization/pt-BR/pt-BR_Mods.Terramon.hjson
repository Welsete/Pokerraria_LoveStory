	Tooltip: Prova da vitória sobre Lt. Surge, o Líder de Ginásio de Vermilion
}

Items.RainbowBadge: {
	DisplayName: Insígnia Arco-Íris
	Tooltip: Prova da vitória sobre Erika, a Líder de Ginásio de Celadon
}

Items.SoulBadge: {
	DisplayName: Insígnia Alma
	Tooltip: Prova da vitória sobre Koga, o Líder de Ginásio de Fuchsia
