Commands: {
	Heal: {
		Description: Cura toda a sua equipe e revive Pokémon desmaiados (depuração)
		Usage: /heal [espaço|all]
		Success: "{0} Pokémon curado(s)"
	}

	Level: {
		Description: Sobe o nível de um Pokémon da sua equipe (depuração)
		Usage: /level <espaço> [níveis]
	}

	Trainer: {
		Description: Coloca um treinador (como um Líder de Ginásio) ao seu lado
		Usage: /trainer <nome>
		NotFound: "Nenhum treinador chamado '{0}' foi encontrado"
	}

	RequiresDebugMode: Este comando exige que a opção Permitir Comandos de Trapaça esteja ativada nas configurações do mod!

	DexEdit: {
		Description: Define à força o status das entradas da Pokédex
		Usage: /dexedit <id> <status>
		ParseErrorID: Não foi possível ler o argumento de ID como número inteiro
		ParseErrorStatus: Não foi possível ler o argumento de status como número inteiro
		StatusOutOfRange: O argumento de status está fora do intervalo (0-2)
		IDOutOfRange: A entrada {0} da Pokédex está fora do intervalo (1-{1})
		Success: Entrada {0} da Pokédex definida com o status {1}
	}

	Nickname: {
		Description: Define o apelido de um Pokémon
		Usage: /nickname <set|clear> <apelido>

		Set: {
			NoActivePokemon: Nenhum Pokémon está ativo no momento
			NoNicknameProvided: Nenhum apelido foi informado
			NicknameTooLong: O apelido deve ter no máximo 12 caracteres (incluindo espaços)
			SameNickname: O apelido já é esse
			SuccessNew: Apelido de {0} definido como {1}
			SuccessUpdate: Apelido de {0} alterado de {1} para {2}
		}

		Clear: {
			NoNicknameSet: Este Pokémon não tem apelido
			Success: Apelido de {0} removido
		}

		InvalidSubcommand: Subcomando inválido. Use \"set\" ou \"clear\"
	}

	Party: {
		ParseErrorSlot: Não foi possível ler o argumento de espaço como número inteiro
		SlotOutOfRange: O argumento de espaço está fora do intervalo (1-6)
	}

	PartyClear: {
		Description: Remove o Pokémon indicado da sua equipe
		Usage: /partyclear <espaço|all>
		NoPokemonInSlot: Nenhum Pokémon encontrado no espaço {0}
		Success: "{0} foi removido da equipe"
		SuccessAll: Todos os Pokémon foram removidos da equipe
	}

	PartyData: {
		Description: Registra as informações do Pokémon indicado da sua equipe
		Usage: /partydata <espaço>
		NoPokemonInSlot: Não há dados de Pokémon para o espaço {0}
		Success: Dados do Pokémon do espaço {0} gravados em client.log
	}

	PokeClear: {
		Description: Remove todos os NPCs Pokémon ativos do mundo
		Usage: /pokeclear
		Success: "{0} NPC(s) Pokémon removido(s)"
		SuccessByPlayer: "{0} removeu {1} NPC(s) Pokémon"
	}

	PC: {
		Description: Abre o Sistema de Armazenamento Pokémon (PC) de qualquer lugar
		Usage: /pc
	}

	Dex: {
		Description: Abre a Pokédex
		Usage: /dex
	}

	Upgrade: {
		Description: Transfere Pokémon da versão de pré-lançamento
		Usage: /upgrade
		TypeResolveError: Um ou mais tipos antigos necessários não foram encontrados! Informe este problema aos desenvolvedores do Terramon
		NopUpgrade: Nenhum Pokémon foi encontrado no inventário para atualizar
		Success: "{0} Pokémon atualizado(s) e transferido(s) para o PC de {1}"
	}

	BannerData: {
		Description: Altera o nível do estandarte Pokémon que você está segurando
		Usage: /bannerset <nível>
		NotHoldingBanner: O item que você está segurando não é um estandarte Pokémon
		ParseErrorBannerTier: Não foi possível ler o argumento de nível como BannerTier
		Success: Nível do estandarte segurado alterado para {0}
	}

	Starter: {
		Description: Abre o menu de escolha do Pokémon inicial (só funciona se você ainda não escolheu um)
		Usage: /starter
		AlreadyChosen: Você já escolheu seu Pokémon inicial!
	}

	Choose: {
		Description: Atalho para /starter
		Usage: /choose
	}
}

Configs: {
	ClientConfig: {
		DisplayName: Configuração Pessoal

		Headers: {
			Miscellaneous: Jogabilidade
			GUI: Interface (GUI)
			Accessibility: Acessibilidade e Personalização
		}

		FastEvolution: {
			Label: Evolução Rápida
			Tooltip: Se os Pokémon devem evoluir automaticamente ao usar um Doce Raro (senão, fale com o {$NPCs.PokemartClerk.DisplayName})
		}

		ShowPokedexRegistrationMessages: {
			Label: Mensagens de Registro na Pokédex
			Tooltip: Se deve aparecer uma mensagem no chat quando um novo Pokémon for registrado na Pokédex
		}

		LegacyStarterSelectUI: {
			Label: (Escolha do Inicial) Usar Interface Antiga
			Tooltip: Usa a interface de escolha do Pokémon inicial das versões anteriores do mod
		}

		ReducedAudio: {
			Label: (Barra da Equipe) Áudio Reduzido
			Tooltip: Desativa os tons musicais ao reorganizar os Pokémon na barra lateral
		}

		HighlightSelectedPokemonName: {
			Label: (Barra da Equipe) Destacar Nome do Pokémon Selecionado
			Tooltip: Destaca o nome do Pokémon selecionado na barra lateral da equipe
		}

		ReducedMotion: {
			Label: (Espaços do Inventário) Movimento Reduzido
			Tooltip: Desativa a animação de deslizar ao mostrar ou esconder os espaços da equipe no inventário
		}

		ShowPetNameOnHover: {
			Label: Mostrar Nome do Pokémon Companheiro ao Passar o Mouse
			Tooltip: Se o nome do Pokémon companheiro deve aparecer ao passar o mouse sobre ele no mundo
		}

		ModIconType: {
			Label: Tipo de Ícone do Mod
			Tooltip: Altera o ícone do mod
		}

		AnimatedModIcon: {
			Label: Ícone do Mod Animado
			Tooltip: Anima o ícone do mod no menu de Mods quando o mod está ativado
		}

		RainbowBuffText: {
			Label: Texto do Buff com Arco-Íris
			Tooltip: O nome do buff do Pokémon companheiro alterna entre as cores do arco-íris
		}

		ThickHighlights: {
			Label: Contorno Grosso nos Pokémon
			Tooltip: Se deve usar contornos mais grossos ao destacar Pokémon com os quais você pode interagir ou batalhar
		}

		HighlightColor: {
			Label: Cor do Destaque dos Pokémon
			Tooltip: Personaliza a cor do contorno exibido ao passar o mouse sobre um Pokémon com o qual você pode interagir ou batalhar
		}
	}

	GameplayConfig: {
		DisplayName: Configuração Global

		Headers: {
			Spawning: Aparecimento
			Visuals: Visual
			Miscellaneous: Diversos
			Advanced: Avançado
		}

		PokemonSpawnRateMultiplier: {
			Label: Multiplicador de Aparecimento de Pokémon
			Tooltip:
				'''
				Multiplica a frequência com que os Pokémon aparecem na natureza
				[c/F2A754:Se for 0, nenhum Pokémon vai aparecer]
				'''
		}

		NonPokemonSpawnRateMultiplier: {
			Label: Multiplicador de Aparecimento de Não-Pokémon
			Tooltip:
				'''
				Multiplica a frequência com que aparecem NPCs que não são Pokémon, incluindo os de outros mods
				[c/F2A754:Se for 0, os inimigos normais do Terraria e os NPCs de outros mods não vão aparecer]
				'''
		}

		SpawningStage: {
			Label: Estágio de Aparecimento
			Tooltip: O estágio dos Pokémon que podem aparecer na natureza (estágios maiores incluem todos os menores)
		}

		EncourageDespawning: {
			Label: Incentivar Desaparecimento
			Tooltip: Se os Pokémon selvagens devem desaparecer quando você sai de uma área, abrindo espaço para novos aparecerem
		}

		ShinySpawnRate: {
			Label: Chance de Shiny
			Tooltip: A raridade de Pokémon Shiny aparecerem na natureza (1/x)
		}

		FastAnimations: {
			Label: Animações Rápidas
			Tooltip: Se deve pular as animações de certos eventos (por exemplo, capturar um Pokémon)
		}

		ShinyLockedStarters: {
			Label: Pokémon Iniciais Nunca Shiny
			Tooltip: Impede que o primeiro parceiro (Pokémon inicial) seja shiny
		}

		DebugMode: {
			Label: Permitir Comandos de Trapaça
			Tooltip:
				'''
				Permite usar comandos de trapaça (por exemplo, /pokeclear) no chat
				[c/F2A754:Pode atrapalhar o jogo normal]
				'''
		}
	}

	SpawningStage: {
