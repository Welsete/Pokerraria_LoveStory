		AutoDeclined: "Declined {0}'s challenge: {1}"
		ReasonBusy: you're already in a battle or deciding on another challenge.
		ReasonNoPokemon: your active Pokémon can't battle (send out a healthy one first).
		NeedPokemon: Send out a healthy Pokémon before challenging someone!
		ReasonTooFar: they're too far away.
	}
}

